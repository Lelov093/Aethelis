# ── LLM Provider ─────────────────────────────────────────────────────
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.6-plus-2026-04-02
OPENAI_MODEL_FALLBACKS=qwen3.6-plus,glm-5.1,qwen3.6-flash-2026-04-16,qwen3.6-35b-a3b,qwen3.6-flash
OPENAI_API_KEY=sk-xxx
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=1
OPENAI_ENABLE_THINKING=false

# ── Embedding ────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=volcengine_ark
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_MODEL=doubao-embedding-vision-251215
EMBEDDING_API_KEY=sk-xxx
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=sk-xxx
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=1

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:<postgres-password>@localhost:5432/aethelis

# Product API access. Local single-user is the P2 default and must stay loopback-only.
AETHELIS_AUTH_MODE=local_single_user
AETHELIS_LOCAL_PRINCIPAL_ID=principal_local_player
AETHELIS_LOCAL_PROFILE_ID=profile_local_player
AETHELIS_LOCAL_DISPLAY_NAME=雾门旅人
AETHELIS_LOCAL_LOCALE=zh-CN
AETHELIS_LOCAL_ALLOWED_ORIGIN=http://localhost:5173

# Optional future hosted-mode OIDC verification. Ignored in local_single_user mode.
AETHELIS_OIDC_PROVIDER_ID=replace-me
AETHELIS_OIDC_ISSUER=https://identity.example.com
AETHELIS_OIDC_AUDIENCE=aethelis-api
AETHELIS_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
AETHELIS_OIDC_ALGORITHMS=RS256
AETHELIS_API_HOST=127.0.0.1
AETHELIS_API_PORT=8000
AETHELIS_WORKER_POLL_SECONDS=1.0
